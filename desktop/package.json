{
  "name": "findmegamer-desktop",
  "productName": "FindMeGamer",
  "version": "0.2.0-internal.5",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "check": "npm run typecheck && npm test && npm run build",
    "test:desktop": "npm run build && playwright test",
    "bundle:dir": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/node": "26.5.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.0.1",
    "esbuild": "0.28.2",
    "electron": "44.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": { "node": ">=24.14" }
}
