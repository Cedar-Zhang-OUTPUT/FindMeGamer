{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated Creator Import v1",
  "$defs": {
    "AudienceInference": {
      "additionalProperties": false,
      "properties": {
        "primary_language": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/AvailableInferenceText",
              "unavailable": "#/$defs/UnavailableInference"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AvailableInferenceText"
            },
            {
              "$ref": "#/$defs/UnavailableInference"
            }
          ],
          "title": "Primary Language"
        },
        "likely_regions": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/AvailableInferenceList",
              "unavailable": "#/$defs/UnavailableInference"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AvailableInferenceList"
            },
            {
              "$ref": "#/$defs/UnavailableInference"
            }
          ],
          "title": "Likely Regions"
        },
        "interests": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/AvailableInferenceList",
              "unavailable": "#/$defs/UnavailableInference"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AvailableInferenceList"
            },
            {
              "$ref": "#/$defs/UnavailableInference"
            }
          ],
          "title": "Interests"
        }
      },
      "required": [
        "primary_language",
        "likely_regions",
        "interests"
      ],
      "title": "AudienceInference",
      "type": "object"
    },
    "AvailableContactSelection": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "candidate_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "candidate_id"
      ],
      "title": "AvailableContactSelection",
      "type": "object"
    },
    "AvailableInferenceList": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "provenance": {
          "const": "ai_inference",
          "title": "Provenance",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "status",
        "values",
        "provenance",
        "evidence",
        "confidence"
      ],
      "title": "AvailableInferenceList",
      "type": "object"
    },
    "AvailableInferenceText": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "provenance": {
          "const": "ai_inference",
          "title": "Provenance",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "status",
        "value",
        "provenance",
        "evidence",
        "confidence"
      ],
      "title": "AvailableInferenceText",
      "type": "object"
    },
    "AvailableListClaim": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "status",
        "values",
        "evidence",
        "confidence"
      ],
      "title": "AvailableListClaim",
      "type": "object"
    },
    "AvailableSocialSelections": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "candidate_ids": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Candidate Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "candidate_ids"
      ],
      "title": "AvailableSocialSelections",
      "type": "object"
    },
    "AvailableTextClaim": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "status",
        "value",
        "evidence",
        "confidence"
      ],
      "title": "AvailableTextClaim",
      "type": "object"
    },
    "BriefEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "source_fact",
            "visual_observation",
            "ai_inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "steam_field",
            "video_id",
            "channel_field",
            "visual_asset",
            "public_link",
            "intermediate_output"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "reference": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_type",
        "reference"
      ],
      "title": "BriefEvidenceReference",
      "type": "object"
    },
    "CompactAvailableInferenceText": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "provenance": {
          "const": "ai_inference",
          "title": "Provenance",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/BriefEvidenceReference"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "status",
        "value",
        "provenance",
        "evidence",
        "confidence"
      ],
      "title": "CompactAvailableInferenceText",
      "type": "object"
    },
    "CompactUnavailableInference": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unavailable",
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "provenance": {
          "const": "ai_inference",
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "provenance"
      ],
      "title": "CompactUnavailableInference",
      "type": "object"
    },
    "Contact": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "purpose": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "source_url": {
          "maxLength": 512,
          "minLength": 8,
          "title": "Source Url",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "email",
        "purpose",
        "source_url",
        "observed_at"
      ],
      "title": "Contact",
      "type": "object"
    },
    "ContentLanguage": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 35,
          "minLength": 2,
          "title": "Code",
          "type": "string"
        },
        "basis": {
          "enum": [
            "platform_metadata",
            "observed_content",
            "creator_statement"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source_url": {
          "maxLength": 512,
          "minLength": 8,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "code",
        "basis",
        "source_url"
      ],
      "title": "ContentLanguage",
      "type": "object"
    },
    "CreatorBrief": {
      "additionalProperties": false,
      "description": "Compact, score-free input used by later matching stages.",
      "properties": {
        "positioning": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CreatorBriefAvailableTextClaim",
              "unavailable": "#/$defs/CreatorBriefUnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CreatorBriefAvailableTextClaim"
            },
            {
              "$ref": "#/$defs/CreatorBriefUnavailableClaim"
            }
          ],
          "title": "Positioning"
        },
        "content_focus": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CreatorBriefAvailableListClaim",
              "unavailable": "#/$defs/CreatorBriefUnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CreatorBriefAvailableListClaim"
            },
            {
              "$ref": "#/$defs/CreatorBriefUnavailableClaim"
            }
          ],
          "title": "Content Focus"
        },
        "formats": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CreatorBriefAvailableListClaim",
              "unavailable": "#/$defs/CreatorBriefUnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CreatorBriefAvailableListClaim"
            },
            {
              "$ref": "#/$defs/CreatorBriefUnavailableClaim"
            }
          ],
          "title": "Formats"
        },
        "style_and_pacing": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CreatorBriefAvailableTextClaim",
              "unavailable": "#/$defs/CreatorBriefUnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CreatorBriefAvailableTextClaim"
            },
            {
              "$ref": "#/$defs/CreatorBriefUnavailableClaim"
            }
          ],
          "title": "Style And Pacing"
        },
        "audience": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CompactAvailableInferenceText",
              "unavailable": "#/$defs/CompactUnavailableInference"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CompactAvailableInferenceText"
            },
            {
              "$ref": "#/$defs/CompactUnavailableInference"
            }
          ],
          "title": "Audience"
        },
        "performance_context": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CreatorBriefAvailableTextClaim",
              "unavailable": "#/$defs/CreatorBriefUnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CreatorBriefAvailableTextClaim"
            },
            {
              "$ref": "#/$defs/CreatorBriefUnavailableClaim"
            }
          ],
          "title": "Performance Context"
        },
        "promotion_fit": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CreatorBriefAvailableTextClaim",
              "unavailable": "#/$defs/CreatorBriefUnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CreatorBriefAvailableTextClaim"
            },
            {
              "$ref": "#/$defs/CreatorBriefUnavailableClaim"
            }
          ],
          "title": "Promotion Fit"
        },
        "brand_safety": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CreatorBriefAvailableTextClaim",
              "unavailable": "#/$defs/CreatorBriefUnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CreatorBriefAvailableTextClaim"
            },
            {
              "$ref": "#/$defs/CreatorBriefUnavailableClaim"
            }
          ],
          "title": "Brand Safety"
        },
        "suitable_game_types": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CreatorBriefAvailableListClaim",
              "unavailable": "#/$defs/CreatorBriefUnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CreatorBriefAvailableListClaim"
            },
            {
              "$ref": "#/$defs/CreatorBriefUnavailableClaim"
            }
          ],
          "title": "Suitable Game Types"
        },
        "collaboration_risks": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/CreatorBriefAvailableListClaim",
              "unavailable": "#/$defs/CreatorBriefUnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CreatorBriefAvailableListClaim"
            },
            {
              "$ref": "#/$defs/CreatorBriefUnavailableClaim"
            }
          ],
          "title": "Collaboration Risks"
        }
      },
      "required": [
        "positioning",
        "content_focus",
        "formats",
        "style_and_pacing",
        "audience",
        "performance_context",
        "promotion_fit",
        "brand_safety",
        "suitable_game_types",
        "collaboration_risks"
      ],
      "title": "CreatorBrief",
      "type": "object"
    },
    "CreatorBriefAvailableListClaim": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/BriefEvidenceReference"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "status",
        "values",
        "evidence",
        "confidence"
      ],
      "title": "CreatorBriefAvailableListClaim",
      "type": "object"
    },
    "CreatorBriefAvailableTextClaim": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "available",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/BriefEvidenceReference"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "status",
        "value",
        "evidence",
        "confidence"
      ],
      "title": "CreatorBriefAvailableTextClaim",
      "type": "object"
    },
    "CreatorBriefUnavailableClaim": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unavailable",
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "CreatorBriefUnavailableClaim",
      "type": "object"
    },
    "CreatorImportRecord": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": [
            "twitch",
            "instagram"
          ],
          "title": "Platform",
          "type": "string"
        },
        "platform_account_id": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform Account Id"
        },
        "account_id_source_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id Source Url"
        },
        "profile_url": {
          "maxLength": 512,
          "minLength": 8,
          "title": "Profile Url",
          "type": "string"
        },
        "username": {
          "pattern": "^[A-Za-z0-9_.]{1,30}$",
          "title": "Username",
          "type": "string"
        },
        "display_name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "bio_original": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bio Original"
        },
        "avatar_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avatar Url"
        },
        "website_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Website Url"
        },
        "followers_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Followers Count"
        },
        "followers_precision": {
          "enum": [
            "exact",
            "rounded",
            "unknown"
          ],
          "title": "Followers Precision",
          "type": "string"
        },
        "content_languages": {
          "items": {
            "$ref": "#/$defs/ContentLanguage"
          },
          "title": "Content Languages",
          "type": "array"
        },
        "public_location": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Location"
        },
        "platform_metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Platform Metrics",
          "type": "array"
        },
        "works": {
          "items": {
            "$ref": "#/$defs/Work"
          },
          "title": "Works",
          "type": "array"
        },
        "contacts": {
          "items": {
            "$ref": "#/$defs/Contact"
          },
          "title": "Contacts",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "collection_notes": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Notes"
        },
        "analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/CuratedAnalysis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "platform",
        "profile_url",
        "username",
        "display_name",
        "collected_at",
        "followers_precision"
      ],
      "title": "CreatorImportRecord",
      "type": "object"
    },
    "CreatorSynthesis": {
      "additionalProperties": false,
      "description": "AI-owned Creator fields plus pipeline-resolved contact selections.",
      "properties": {
        "english_language_check": {
          "const": true,
          "title": "English Language Check",
          "type": "boolean"
        },
        "content_summary": {
          "discriminator": {
            "mapping": {
              "available": "#/$defs/AvailableTextClaim",
              "unavailable": "#/$defs/UnavailableClaim"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AvailableTextClaim"
