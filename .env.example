# Public deployment identity
SERVICE_DOMAIN=demo.find-me-gamer.example.invalid

# Replace every value below during host bootstrap. These are inert examples,
# not deployable credentials.
POSTGRES_DB=find_me_gamer
POSTGRES_USER=find_me_gamer
POSTGRES_PASSWORD=replace-with-generated-database-password
WORKSPACE_ACCESS_KEY_HASH=replace-with-generated-argon2id-hash

# The EC2 instance role supplies AWS credentials; never place access keys here.
FMG_AWS_REGION=us-east-1
FMG_S3_BUCKET=replace-with-private-artifact-bucket-name
