{
	default_sni {$SERVICE_DOMAIN:localhost}
}

{$SERVICE_DOMAIN:localhost} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}

	@backend path /api/* /r/* /health/live /health/ready

	@macos_update {
		method GET HEAD
		path /updates/macos.json
	}

	handle @macos_update {
		header {
			Content-Type "application/json; charset=utf-8"
			Cache-Control "no-store"
			X-Content-Type-Options "nosniff"
			-Server
		}
		respond `{"schema_version":1,"version":"0.4.1","release_page_url":"https://github.com/Cedar-Zhang-OUTPUT/FindMeGamer/releases/tag/v0.4.1-internal.1"}` 200
	}

	handle @backend {
		header {
			Cache-Control "no-store"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			-Server
		}
		reverse_proxy api:8000
	}

	handle {
		respond "Not Found" 404
	}
}
