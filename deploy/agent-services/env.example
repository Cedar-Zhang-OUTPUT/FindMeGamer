# Private SERVICE env file, chmod 600. Do not reuse/commit the old client env.
FMG_AGENT_DATABASE_URL=postgresql+psycopg://AGENT_ROLE:PASSWORD@postgres:5432/find_me_gamer_agent
FMG_AGENT_BROKER_URL=redis://redis:6379/0
FMG_AGENT_YOUTUBE_API_KEY=
FMG_AGENT_X_BEARER_TOKEN=
FMG_AGENT_TWITCH_CLIENT_ID=
FMG_AGENT_TWITCH_CLIENT_SECRET=
FMG_AGENT_TWITCH_USER_TOKEN=
FMG_AGENT_TWITCH_REFRESH_TOKEN=
FMG_AGENT_TWITCH_TOKEN_STORE=/srv/twitch-oauth/tokens.json
FMG_AGENT_STEAM_API_KEY=
FMG_AGENT_GEMINI_API_KEY=
FMG_AGENT_GEMINI_MODEL=
FMG_AGENT_SMTP_HOST=
FMG_AGENT_SMTP_PORT=465
FMG_AGENT_SMTP_ENCRYPTION=tls
FMG_AGENT_SMTP_USERNAME=
FMG_AGENT_SMTP_PASSWORD=
FMG_AGENT_SMTP_FROM=
# Optional test-only allowlist. Empty list permits normal approved sending.
FMG_AGENT_SMTP_ALLOWED_RECIPIENTS=[]
# Public HTTPS origin (no /v1 suffix); used for per-recipient confirmation links.
FMG_AGENT_OUTREACH_PUBLIC_URL=
FMG_AGENT_EMAIL_RETENTION_DAYS=30
